# ============================================================
# WP API — environment config. Copy to ".env" and fill in.
# .env is blocked from the web by .htaccess. Never commit/share it.
# ============================================================

APP_NAME="WP API"
APP_ENV=production            # production | local
APP_DEBUG=false               # true shows PHP errors (ignored in production)
APP_URL=https://wpapi.grdpinfotech.com
APP_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# 64 random hex chars. Encrypts stored WhatsApp tokens — do NOT change after go-live.
# Generate: php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=

# Meta / WhatsApp Cloud API
WA_API_VERSION=v23.0
META_APP_SECRET=              # App Dashboard -> App settings -> Basic -> App Secret
META_APP_ID=                  # Embedded Signup (optional)
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_ES_REGISTER_PIN=

# Razorpay (Dashboard -> API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP (Hostinger). If MAIL_PASS is empty, mails are written to storage/logs/mail.log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

SUPPORT_EMAIL=info@grdpinfotech.com
SUPPORT_PHONE=

# migrate.php?key=... and HTTP cron
CRON_SECRET=
